{
  "uid": "blogapp",
  "title": "BlogReact - EKS health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [{ "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus" }] },
  "panels": [
    { "id": 1, "title": "CPU by pod", "type": "timeseries", "gridPos": {"x":0,"y":0,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults":{"unit":"cores"},"overrides":[]},
      "targets": [{"refId":"A","expr":"sum(rate(container_cpu_usage_seconds_total{namespace=\"blogapp\",container!=\"\"}[5m])) by (pod)","legendFormat":"{{pod}}"}] },
    { "id": 2, "title": "Memory by pod", "type": "timeseries", "gridPos": {"x":12,"y":0,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults":{"unit":"bytes"},"overrides":[]},
      "targets": [{"refId":"A","expr":"sum(container_memory_working_set_bytes{namespace=\"blogapp\",container!=\"\"}) by (pod)","legendFormat":"{{pod}}"}] },
    { "id": 3, "title": "Pod restarts", "type": "timeseries", "gridPos": {"x":0,"y":8,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"refId":"A","expr":"sum(kube_pod_container_status_restarts_total{namespace=\"blogapp\"}) by (pod)","legendFormat":"{{pod}}"}] },
    { "id": 4, "title": "Pod status", "type": "timeseries", "gridPos": {"x":12,"y":8,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"refId":"A","expr":"sum(kube_pod_status_phase{namespace=\"blogapp\"}) by (phase)","legendFormat":"{{phase}}"}] },
    { "id": 5, "title": "Node readiness", "type": "timeseries", "gridPos": {"x":0,"y":16,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"refId":"A","expr":"kube_node_status_condition{condition=\"Ready\",status=\"true\"}","legendFormat":"{{node}}"}] },
    { "id": 6, "title": "Database connectivity", "type": "timeseries", "gridPos": {"x":12,"y":16,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"refId":"A","expr":"blogapp_database_up{namespace=\"blogapp\"}","legendFormat":"{{pod}}"}] },
    { "id": 7, "title": "API request rate", "type": "timeseries", "gridPos": {"x":0,"y":24,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults":{"unit":"reqps"},"overrides":[]},
      "targets": [{"refId":"A","expr":"sum(rate(http_request_duration_seconds_count{namespace=\"blogapp\"}[5m])) by (status)","legendFormat":"{{status}}"}] },
    { "id": 8, "title": "API p95 latency", "type": "timeseries", "gridPos": {"x":12,"y":24,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults":{"unit":"s"},"overrides":[]},
      "targets": [{"refId":"A","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"blogapp\"}[5m])) by (le))","legendFormat":"p95"}] }
  ]
}

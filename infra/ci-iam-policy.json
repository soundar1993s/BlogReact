{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "RegistryLogin", "Effect": "Allow", "Action": ["ecr:GetAuthorizationToken"], "Resource": "*" },
    { "Sid": "PublishApplicationImages", "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage"],
      "Resource": ["arn:aws:ecr:REGION:ACCOUNT_ID:repository/blogapp-backend", "arn:aws:ecr:REGION:ACCOUNT_ID:repository/blogapp-frontend"] },
    { "Sid": "DiscoverCluster", "Effect": "Allow", "Action": ["eks:DescribeCluster"],
      "Resource": "arn:aws:eks:REGION:ACCOUNT_ID:cluster/blogapp-eks" }
  ]
}
